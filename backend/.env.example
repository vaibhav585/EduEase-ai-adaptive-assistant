# Copy to .env and fill in. NEVER commit .env
GOOGLE_API_KEY=your_gemini_api_key_here
FIREBASE_CREDENTIALS=serviceAccountKey.json
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Optional: fallback text-completion provider when Gemini's quota is exhausted.
# Free at https://console.groq.com. Vision (image descriptions) still needs
# Gemini regardless — Groq is text-only here. Leave blank to disable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
